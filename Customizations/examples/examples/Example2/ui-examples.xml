						<JProperty name="xtype"><JValue>hxgn-sidebarpanel</JValue></JProperty>
						<JProperty name="region"><JValue>west</JValue></JProperty>
						<JProperty name="tabRotation"><JValue>default</JValue></JProperty>						
					</JObject>
					<JObject>
						<JProperty name="xtype"><JValue>hxgn-mapmainpanel</JValue></JProperty>
						<JProperty name="region"><JValue>center</JValue></JProperty>
						<JProperty name="modes">
							<JArray>
